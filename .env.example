# TrustLink SCS 설정 — docker-compose.yaml 과 같은 폴더에 .env 로 저장 후 값 변경
# (설정 값에 큰따옴표 " 와 역슬래시 \ 는 쓰지 않는다)

# ===== 접속 =====
FRONT_HOST=trustlink          # 브라우저가 접속하는 호스트(도메인 또는 IP)
FRONT_PORT=28080

# ===== 모듈 이미지 (TrustLink 는 주소만 안다 — 공식 이미지 무수정, 버전 고정) =====
# 업데이트: 태그만 바꾸고 `docker compose pull && docker compose up -d` (데이터는 볼륨에 유지)
ZOT_IMAGE=ghcr.io/project-zot/zot:v2.1.18
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1
KEYCLOAK_DB_IMAGE=postgres:16
DTRACK_IMAGE=dependencytrack/apiserver:4.14.3
DTRACK_DB_IMAGE=postgres:16
HTTPD_IMAGE=httpd:2.4         # htpasswd 생성용(1회성)
TRUSTLINK_ADMIN_IMAGE=jkkim7202/trustlink-admin:latest   # 개발 PC 는 trustlink-admin:latest (admin-bff/build.sh)

# ===== 설치 시 생성되는 TrustLink 관리자 (admins 그룹) =====
# 최초 기동 때 1회만 생성된다. 이후 이 값을 바꿔도 기존 비밀번호는 바뀌지 않는다(로그인 후 변경 권장).
TL_ADMIN_USER=tladmin
TL_ADMIN_PASSWORD=change-me-tladmin

# 데모 계정(dev1·dev2·partner1·acme1·admin1 … / Passw0rd!) — 필요할 때만 주석 해제
#COMPOSE_PROFILES=demo

# ===== Keycloak =====
KC_ADMIN=admin                # master realm 관리자(Keycloak 관리 콘솔 /auth/admin 전용)
KC_ADMIN_PASSWORD=change-me-admin
KC_DB_PASSWORD=change-me-kcdb # Keycloak 전용 DB(keycloak-db)
TRUSTLINK_ADMIN_SECRET=change-me-bff-client-secret   # BFF OIDC 클라이언트 시크릿
ZOT_OIDC_CLIENT_SECRET=change-me-zot-client-secret   # zot OIDC 클라이언트 시크릿

# ===== 레지스트리(zot) =====
CI_PASSWORD=change-me-ci      # 업로드용 공용 계정 ci
SVC_BFF_PASS=change-me-svc    # BFF 내부 관리 계정 svc-bff
ZOT_RETENTION_DRYRUN=true     # false 로 바꾸면 보존정책(최근 10개+latest 외 삭제) 실제 적용

# ===== Dependency-Track =====
DT_DB_PASSWORD=change-me-dtdb
DT_ADMIN_PASSWORD=change-me-dtadmin   # 최초 기동 시 BFF 가 DT admin 비밀번호로 설정하고 API 키를 자동 발급
#DT_API_KEY=                  # 직접 지정할 때만(비우면 자동 발급 키 사용)
#DTRACK_MEM_LIMIT=4608m
